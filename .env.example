[TEMPLATE]
# ── Model routing (LiteLLM provider strings) ────────────────────────────────
# Any LiteLLM model string works: openai/gpt-4o-mini, anthropic/claude-3-5-sonnet,
# ollama/llama3.1, vertex_ai/gemini-1.5-pro, azure/<deployment>, ...
EXTRACT_MODEL=litellm/gpt-4o-mini
# Vision-capable model used for scanned PDF pages (falls back to EXTRACT_MODEL).
EXTRACT_VISION_MODEL=litellm/gpt-4o-mini

# Provider keys as needed by your chosen model string:
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=...
# OLLAMA_API_BASE=http://localhost:11434

# ── Extraction backend ──────────────────────────────────────────────────────
# instructor   -> prompt-based structured output + validation-feedback retries (any provider)
# outlines     -> grammar-constrained decoding (local models: transformers, vLLM, Ollama)
EXTRACT_BACKEND=instructor

# ── Determinism ─────────────────────────────────────────────────────────────
EXTRACT_TEMPERATURE=0.0
EXTRACT_SEED=7

# ── Retry / feedback loop ───────────────────────────────────────────────────
EXTRACT_MAX_ATTEMPTS=4
# Extra attempts that re-inject DOM regions / page images on validation failure.
EXTRACT_MAX_ESCALATIONS=2

# ── Playwright ──────────────────────────────────────────────────────────────
EXTRACT_PAGE_TIMEOUT_MS=45000
EXTRACT_NAV_WAIT_UNTIL=networkidle
# Force plain-HTTP fetching (no Chromium). Auto-used on hosts without a browser
# (e.g. Vercel Functions); set to 1 to opt out of browser rendering everywhere.
# EXTRACT_DISABLE_BROWSER=0

# ── PDF ─────────────────────────────────────────────────────────────────────
# Chars per square inch; pages below this are treated as scanned (vision fallback).
EXTRACT_PDF_TEXT_DENSITY=5.0
EXTRACT_PDF_DPI=170

# ── Cache (deterministic replays) ───────────────────────────────────────────
EXTRACT_CACHE_DIR=.cache
EXTRACT_CACHE_TTL_HOURS=24

# ── Misc ────────────────────────────────────────────────────────────────────
EXTRACT_USER_SCHEMA_DIR=schemas_user
EXTRACT_AUDIT_DIR=audit
EXTRACT_LOG_LEVEL=INFO
